{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Enviro Travail",
  "version": "0.1.0",
  "identifier": "fr.artfx.envirotravail",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Enviro Travail",
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["French"]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJCNTExNUU3RjQxMjNFOTcKUldTWFBoTDA1eFZSSzM5Nm52OVkwU01QeEk1YU9leUQvKzBENG9KWkJPaGZkQ0xlWWlYYksrMFkK",
      "endpoints": [
        "https://github.com/VOTRE-COMPTE-GITHUB/enviro-travail/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
